---
/**
 * Base document shell.
 *
 * Fonts are self-hosted — the Google Fonts <link> tags from the original
 * marketing-homepage.html are deliberately gone. LibreChart's product runs on
 * offline clinic networks and the site holds the same line.
 */
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  title: string;
  description: string;
  /** Set to false on pages that should not be indexed. */
  indexable?: boolean;
  /**
   * Emit the WebApplication + SoftwareSourceCode JSON-LD nodes as well as the
   * sitewide Organization + WebSite ones. Homepage only - the product entity
   * belongs on one canonical page, not repeated on every page of the site.
   */
  schemaSoftware?: boolean;
  /** The blog post this page renders, if any. Adds a BlogPosting JSON-LD node. */
  blogPost?: CollectionEntry<'blog'>;
}

const {
  title,
  description,
  indexable = true,
  schemaSoftware = false,
  blogPost,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/icon-512.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex" />}

    <!-- Only the two faces used above the fold. Preloading all six delays LCP.
         `crossorigin` is required even same-origin, or the browser fetches twice. -->
    <link
      rel="preload"
      href="/fonts/public-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-opsz-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />
    <meta name="theme-color" content="#155B8B" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="LibreChart" />
    <meta name="twitter:card" content="summary_large_image" />

    <Analytics />

    <SchemaOrg includeSoftware={schemaSoftware} post={blogPost} />
  </head>

  <body>
    <slot />

  </body>
</html>
