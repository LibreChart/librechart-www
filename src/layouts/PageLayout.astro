---
/** Standard interior page: header, a titled intro band, content, footer. */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  heading?: string;
  lede?: string;
  indexable?: boolean;
}

const { title, description, heading, lede, indexable = true } = Astro.props;
---

<BaseLayout title={title} description={description} indexable={indexable}>
  <a class="skip-link" href="#main">Skip to main content</a>
  <Header />

  <main id="main">
    {
      heading && (
        <div class="page-head">
          <div class="wrap">
            <h1>{heading}</h1>
            {lede && <p class="lede">{lede}</p>}
          </div>
        </div>
      )
    }
    <div class="wrap page-body">
      <slot />
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-head {
    background: linear-gradient(180deg, #fff 0%, var(--mist) 100%);
    border-bottom: 1px solid var(--border);
    padding: 64px 0 46px;
  }
  .page-head h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.9rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .page-head .lede {
    margin-top: 16px;
    max-width: 640px;
    color: var(--muted);
    font-size: clamp(1.02rem, 2vw, 1.18rem);
  }
  .page-body { padding: 56px 0 88px; }
  @media (max-width: 560px) {
    .page-head { padding: 46px 0 34px; }
    .page-body { padding: 40px 0 64px; }
  }
</style>
