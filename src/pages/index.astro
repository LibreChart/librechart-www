<a id="top"></a>

<!-- ============ HERO ============ -->
<section class="hero" aria-labelledby="hero-title">
  <svg class="hero-ecg" viewBox="0 0 1200 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path class="ecg-trace ecg-anim"
      d="M-20 380 H180 L230 380 L262 300 L300 380 L360 380 L392 250 L430 470 L470 130 L508 380 L560 380 L600 320 L640 380 L820 380 L860 300 L900 380 L960 380 L992 250 L1030 470 L1070 130 L1108 380 L1160 380 L1220 380"/>
  </svg>
  <div class="wrap hero-inner">
    <span class="eyebrow"><span class="dot"></span>Open-source EMR · Runs offline</span>
    <h1 id="hero-title">Patient records that work anywhere care happens.</h1>
    <p class="sub">LibreChart is a free, open-source electronic medical record built for medical mission clinics. It runs on a local network — no internet required — so your team keeps charting whether the clinic is a hospital ward or a tent at the end of a dirt road.</p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="https://github.com/LibreChart/LibreChart#getting-started" rel="noopener">Get started</a>
      <a class="btn btn-secondary" href="https://github.com/LibreChart/LibreChart" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2.1c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.18-1.49 3.14-1.18 3.14-1.18.63 1.58.24 2.75.12 3.04.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>
