---
// B3 step 1 - verbatim paste of branding/marketing-homepage.html <body>.
// Decomposition into components happens in steps 2-4, one at a time, with a
// visual check at 1440/920/780/560/480px after each extraction.
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'LibreChart \u2014 Patient records that work anywhere care happens';
const description =
  'LibreChart is a free, open-source EMR for medical mission clinics. It runs on a local network with no internet required \u2014 self-hosted, offline-first, and licensed GPL-2.0.';
---

<BaseLayout title={title} description={description}>

<a class="skip-link" href="#main">Skip to main content</a>

