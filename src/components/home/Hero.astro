---
/**
 * Hero: promise, sub, CTAs.
 *
 * .hero-inner's padding stays in global.css - it carries .wrap, and scoping the
 * padding would beat `.wrap{padding:0 18px}` at <=480px. See the CASCADE TRAP
 * note in global.css. Only its layout properties are scoped here.
 *
 * The 560px `.hero-ctas .btn, .community-ctas .btn` rule also stays global:
 * it spans two sections, so neither one can own it.
 */
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-inner">
    <span class="eyebrow"><span class="dot"></span>Offline-first open-source EMR</span>
    <h1 id="hero-title">Patient records that work anywhere care happens.</h1>
    <p class="sub">LibreChart is a free, open-source electronic medical record built for medical mission clinics. It runs on a local network — no internet required — so your team keeps charting even when the connection drops.</p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="/docs/getting-started">Get started</a>
      <a class="btn btn-secondary" href="https://github.com/LibreChart/LibreChart" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2.1c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.18-1.49 3.14-1.18 3.14-1.18.63 1.58.24 2.75.12 3.04.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>
        View on GitHub
      </a>
    </div>
    <div class="hero-meta">
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>GPL-2.0 licensed</span>
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Self-hosted, no cloud</span>
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Built on Drupal</span>
    </div>
  </div>
</section>

<style>
  .hero{background:linear-gradient(180deg,#fff 0%,var(--mist) 100%);border-bottom:1px solid var(--border)}
.hero-inner{max-width:820px}
.eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  font-size:14px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;
  color:var(--vital-teal-dark);margin-bottom:22px;
}
.eyebrow .dot{width:8px;height:8px;border-radius:50%;background:var(--vital-teal)}
.hero h1{font-size:clamp(2.3rem,5.2vw,3.7rem);font-weight:700;letter-spacing:-.015em}
.hero .sub{font-size:clamp(1.05rem,2.2vw,1.28rem);color:var(--muted);margin-top:22px;max-width:640px}
.hero-ctas{display:flex;flex-wrap:wrap;gap:14px;margin-top:34px}
.hero-meta{display:flex;flex-wrap:wrap;gap:20px 28px;margin-top:34px;color:var(--muted);font-size:14.5px;font-weight:500}
.hero-meta span{display:inline-flex;align-items:center;gap:8px}
.hero-meta svg{width:17px;height:17px;color:var(--vital-teal);flex:none}

</style>
