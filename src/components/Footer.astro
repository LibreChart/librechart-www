---
/**
 * Site footer.
 *
 * .footer-inner's padding deliberately stays in global.css. The element also
 * carries .wrap, and at <=480px the global `.wrap{padding:0 18px}` is meant to
 * win on source order. Scoping the padding here raises it to
 * `.footer-inner.astro-HASH` (0-2-0), which beats `.wrap` (0-1-0) and strips
 * the footer's side gutters on phones. Only layout properties are scoped. The 560px single-column rule travels with .footer-inner.
 */
---

<footer class="footer">
  <div class="wrap footer-inner">
    <div>
      <a class="logo-lockup" href="#top" aria-label="LibreChart home">
        <!-- Reversed / mono footer treatment: card and tab in white on the Ink background, ECG trace in Vital Teal -->
        <svg class="logo-mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" role="img" aria-label="LibreChart mark">
          <rect x="33" y="11" width="15" height="8" rx="2.5" fill="#FFFFFF"/>
          <rect x="10" y="16" width="44" height="33" rx="5.5" fill="#FFFFFF"/>
          <path d="M2 32 H19.5 L22.5 32 L25 28.2 L27 32 L29.5 32 L31 37.5 L33.2 19 L35.4 40 L37 32 L40 32 L42.5 27.5 L45 32 H62"
                fill="none" stroke="#0E8C7F" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="wordmark"><span class="w-libre">Libre</span><span class="w-chart">Chart</span></span>
      </a>
      <p class="foot-tag">A free, open-source electronic medical record for medical mission clinics. Offline-first, self-hosted, and built on Drupal.</p>
    </div>

    <nav aria-label="Product">
      <h5>Product</h5>
      <ul>
        <li><a href="#features">Features</a></li>
        <li><a href="#how">How it works</a></li>
        <li><a href="https://github.com/LibreChart/LibreChart#getting-started">Get started</a></li>
        <li><a href="https://github.com/LibreChart/LibreChart#readme">Documentation</a></li>
      </ul>
    </nav>

    <nav aria-label="Community">
      <h5>Community</h5>
      <ul>
        <li><a href="https://github.com/LibreChart/LibreChart">GitHub repository</a></li>
        <li><a href="https://github.com/LibreChart/LibreChart/issues">Issue tracker</a></li>
        <li><a href="https://github.com/LibreChart/LibreChart/blob/main/CONTRIBUTING.md">Contributing</a></li>
        <li><a href="https://github.com/LibreChart/LibreChart/blob/main/LICENSE">License</a></li>
      </ul>
    </nav>
  </div>

  <div class="wrap footer-bottom">
    <span>© 2026 The LibreChart project. Free software licensed under <a href="https://github.com/LibreChart/LibreChart/blob/main/LICENSE" rel="noopener">GPL-2.0</a>.</span>
    <a class="gh" href="https://github.com/LibreChart/LibreChart" rel="noopener">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2.1c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.18-1.49 3.14-1.18 3.14-1.18.63 1.58.24 2.75.12 3.04.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>
      github.com/LibreChart/LibreChart
    </a>
  </div>
</footer>

<style>
  .footer{background:var(--ink);color:#B7C6D4}
.footer-inner{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px}
.footer .logo-lockup{color:#fff}
.footer .wordmark{color:#fff}
.footer .foot-tag{margin-top:16px;color:#94A8B8;font-size:.96rem;max-width:320px}
.footer h5{font-family:var(--font-ui);font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#7C93A5;margin:0 0 16px}
.footer ul{list-style:none;margin:0;padding:0;display:grid;gap:11px}
.footer ul a{color:#B7C6D4;font-size:.98rem}
.footer ul a:hover{color:#fff;text-decoration:none}
.footer-bottom{
  border-top:1px solid #2A415A;display:flex;flex-wrap:wrap;gap:14px;
  align-items:center;justify-content:space-between;color:#7C93A5;font-size:.9rem;
}
.footer-bottom a{color:#B7C6D4}
.footer-bottom .gh{display:inline-flex;align-items:center;gap:8px}
.footer-bottom .gh svg{width:18px;height:18px}

  @media (max-width: 560px) {
    .footer-inner{grid-template-columns:1fr;gap:32px}
  }
</style>
