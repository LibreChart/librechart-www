# Cloudflare Workers static-asset headers.
#
# The adapter appends its own immutable rule for /_astro/* at build time, so
# this file is a starting point, not the final artifact - check dist/client/_headers.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # frame-ancestors is ignored in a meta policy, so this is what actually
  # stops clickjacking. The CSP itself is emitted by Astro - see
  # security.csp in astro.config.mjs.
  X-Frame-Options: DENY
